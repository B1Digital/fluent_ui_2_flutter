# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
/pubspec.lock
**/doc/api/
.dart_tool/
.flutter-plugins-dependencies
build/
/coverage/
pubspec_overrides.yaml

# Local tools & documentation
.serena/
doc/
docs/
tool/

# fluent_2_core's token generators are versioned source inputs. Keep them
# tracked while its package-level .pubignore excludes them from release archives.
!/packages/fluent_2_core/tool/

# Crawlers
#
# Local tooling, not shipped: the Playwright install, the crawl output, and the
# scrape scripts themselves. Keep a copy outside the repo if you need to
# regenerate `test/fixtures/*.json` — nothing in git will bring these back.
crawlers/


# Golden-diff output. Written on every failed golden comparison; never an input.
packages/*/test/goldens/failures/

# React-parity triptychs. Written on every parity run, pass or fail; the
# reference PNGs they are built from live in test/fixtures/charts/react_png/
# and ARE committed.
packages/*/test/parity/out/

.claude/worktrees
